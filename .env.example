# ─────────────────────────────────────────────────────────────────────────
# LUCAS // INTELLIGENCE LAB — environment variables
#
# Copy this file to `.env.local` and fill in what you have. Every value
# below is OPTIONAL at the code level: every feature that needs one of
# these has a demo/mock mode and the app builds and runs with none of
# them set. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────

# --- Site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Force demo mode even if API keys ARE present (useful for previews/screenshots)
NEXT_PUBLIC_DEMO_MODE=false

# --- AI provider (Lucas AI Digital Twin, itinerary generation, ---------
# --- agent activity copy in the Business OS demo) ----------------------
# Provide ONE of these. Falls back to scripted demo responses if unset.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Database (Postgres via Supabase) ----------------------------------
# Used for persisted content in the Business OS demo, the knowledge graph,
# and chat history. Falls back to static/demo data if unset.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics / misc (optional, later phases) -------------------------
NEXT_PUBLIC_VERCEL_ANALYTICS=false
